# 前端可见的 API Base URL。
# 保持 /api 即可：开发态由 Vite 代理转发，生产态由 vercel.json rewrites 转发。
# 上游服务未开放 CORS，直接填写 https://agent-staging.agentos-app.app 会被浏览器拦截。
VITE_API_BASE_URL=/api

# 请求身份标识（非密钥，仅用于 Staging 租户区分）
VITE_API_USER_ID=u_dev
VITE_API_AGENT_ID=agent-test-001

# 单次请求超时（毫秒）
VITE_API_TIMEOUT_MS=15000

# 仅开发态生效：Vite 代理的上游地址
API_UPSTREAM_URL=https://agent-staging.agentos-app.app
